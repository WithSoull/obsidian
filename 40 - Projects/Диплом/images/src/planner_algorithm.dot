digraph planner_algorithm {
  graph [rankdir=TB, fontname="Arial", nodesep=0.21, ranksep=0.13, pad=0.2];
  node  [shape=box, fontname="Arial", fontsize=16, margin="0.12,0.05"];
  edge  [fontname="Arial", fontsize=15, arrowsize=0.7];

  start  [label="Начало цикла планирования", shape=ellipse];
  fresh  [label="Данные\nактуальны?", shape=diamond];
  stop   [label="Приостановить прогнозные\nдействия, указать причину"];
  model  [label="Модель\nпригодна?", shape=diamond];
  base   [label="Оценить спрос базовой\nполитикой (F-12)"];
  pred   [label="Оценить μi и выигрыш Δi\nдля текущих версий"];
  sort   [label="Исключить закреплённые, мигрирующие и недавно\nперенесённые версии; упорядочить кандидатов COLD\nпо убыванию Δi/si, версии HOT — по возрастанию"];
  next   [label="Взять следующего кандидата\nна вход в HOT"];
  space  [label="Хватает\nместа?", shape=diamond];
  evict  [label="Подобрать вытесняемые\nверсии HOT с наименьшей\nудельной ценностью"];
  gain   [label="Выигрыш больше потерь\nи порога, бюджет\nдостаточен?", shape=diamond];
  add    [label="Добавить действия и зависимости\nв план, уменьшить бюджет"];
  more   [label="Остались\nкандидаты\nи бюджет?", shape=diamond];
  expl   [label="Сформировать объяснения\nи опубликовать план"];
  end    [label="Конец цикла", shape=ellipse];

  start -> fresh;
  fresh -> stop  [label="нет"];
  stop  -> end;
  fresh -> model [label="да"];
  model -> base  [label="нет"];
  model -> pred  [label="да"];
  base  -> sort;
  pred  -> sort;
  sort -> next -> space;
  space -> gain  [label="да"];
  space -> evict [label="нет"];
  evict -> gain;
  gain  -> add   [label="да"];
  gain  -> more  [label="нет"];
  add   -> more;
  more  -> next  [label="да"];
  more  -> expl  [label="нет"];
  expl  -> end;
  {rank=same; fresh; stop;}
  {rank=same; model; base;}
  {rank=same; space; evict;}
  {rank=same; gain; add;}
}
