digraph components {
  graph [rankdir=TB, fontname="Arial", fontsize=16, nodesep=0.21, ranksep=0.30, pad=0.2, newrank=true];
  node  [shape=component, fontname="Arial", fontsize=19, margin="0.12,0.05"];
  edge  [fontname="Arial", fontsize=17, arrowsize=0.6];

  client  [label="S3-клиент", shape=box, style=rounded];
  browser [label="Браузер администратора", shape=box, style=rounded];

  subgraph cluster_opens3 {
    label="OpenS3 (существующие компоненты)"; labeljust=l; style=dashed;
    gateway  [label="Gateway\n[изменяется]"];
    kafka    [label="Kafka", shape=box];
    metadata [label="Metadata\n[изменяется]"];
    auth     [label="Auth / AuthZ"];
    shot     [label="Storage HOT\n[изменяется]"];
    scold    [label="Storage COLD\n[изменяется]"];
    pgmeta   [label="PostgreSQL\nMetadata", shape=cylinder];
  }
  subgraph cluster_dss {
    label="СППР (новые компоненты)"; labeljust=l; style=solid;
    ingest   [label="Ingestor"];
    features [label="Feature Builder"];
    predictor[label="Predictor (leaves)"];
    planner  [label="Planner и Explainer"];
    api      [label="Admin API\nи веб-интерфейс"];
    modelmgr [label="Model Manager"];
    trainer  [label="Trainer\n(Python, LightGBM)"];
    registry [label="Реестр моделей", shape=folder];
    pgdss    [label="PostgreSQL СППР", shape=cylinder];
  }
  executor [label="Migration Executor\n[новый]"];

  client -> gateway [label="HTTP"];
  gateway -> kafka [style=dashed, label="события"];
  gateway -> metadata [label="gRPC"];
  gateway -> shot;
  gateway -> scold;
  metadata -> pgmeta;
  kafka -> ingest [style=dashed];
  ingest -> features -> predictor -> planner -> api;
  modelmgr -> trainer [label="запуск"];
  modelmgr -> registry [label="проверенная\nмодель"];
  registry -> predictor;
  features -> pgdss [label="агрегаты,\nпризнаки"];
  features -> metadata [label="размер,\nверсия"];
  trainer -> pgdss [label="обучающие\nпримеры"];
  planner -> metadata [label="каталог, классы,\nзанятость"];
  browser -> api [label="HTTPS"];
  api -> auth [label="токен и права"];
  ingest -> pgdss; planner -> pgdss; api -> pgdss;
  executor -> pgdss [label="команды,\nсостояние"];
  executor -> metadata [label="CAS"];
  executor -> shot;
  executor -> scold;

  {rank=same; client; browser;}
  {rank=same; gateway; ingest; modelmgr;}
  {rank=same; shot; scold; pgmeta; executor;}
}
