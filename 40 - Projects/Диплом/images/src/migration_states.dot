digraph migration_states {
  graph [rankdir=TB, fontname="Arial", nodesep=0.35, ranksep=0.3, pad=0.2];
  node  [shape=box, style=rounded, fontname="Arial", fontsize=19, margin="0.1,0.05"];
  edge  [fontname="Arial", fontsize=17, arrowsize=0.6];

  init [label="", shape=circle, style=filled, fillcolor=black, width=0.2];
  approved  [label="Подтверждено"];
  waitdep   [label="Ожидает\nзависимости"];
  validated [label="Проверено\n(версия, поколение,\nресурсы, запреты,\nбюджет)"];
  reserved  [label="Место\nзарезервировано"];
  copying   [label="Копирование"];
  verifying [label="Проверка копии\n(размер, MD5)"];
  switching [label="Переключение\nрасположения (CAS)"];
  cleanup   [label="Ожидание\nочистки источника"];
  done      [label="Завершено\n(расположение новое)"];
  notdone   [label="Не выполнено\n(расположение прежнее)"];
  cancelled [label="Отменено\nадминистратором"];
  rejected  [label="Отклонено\n(устарело, запрет,\nнет ресурсов,\nзависимость)"];
  failed    [label="Ошибка\nдо переключения"];
  dropcopy  [label="Удаление\nцелевой копии"];
  orphansrc [label="Требуется\nочистка источника"];
  orphancp  [label="Требуется\nочистка копии"];
  fin  [label="", shape=doublecircle, style=filled, fillcolor=black, width=0.15];

  init -> approved;
  approved -> waitdep;
  waitdep -> validated [label="зависимость выполнена,\nпроверка пройдена"];
  waitdep -> cancelled [label="отмена"];
  waitdep -> rejected  [label="условие нарушено\nили зависимость\nне выполнена"];
  validated -> reserved -> copying -> verifying;
  verifying -> switching [label="копия совпадает"];
  copying -> failed [label="ошибка чтения\nили записи"];
  verifying -> failed [label="несовпадение"];
  switching -> cleanup [label="CAS успешен"];
  switching -> failed [label="конфликт CAS"];
  failed -> dropcopy;
  dropcopy -> notdone;
  dropcopy -> orphancp [label="удаление\nне удалось"];
  orphancp -> notdone [label="повторная\nочистка"];
  cleanup -> done [label="источник удалён\nпосле паузы"];
  cleanup -> orphansrc [label="удаление\nне удалось"];
  orphansrc -> done [label="повторная\nочистка"];
  rejected -> fin;
  cancelled -> fin;
  notdone -> fin;
  done -> fin;
  {rank=same; waitdep; rejected; cancelled;}
  {rank=same; verifying; failed;}
  {rank=same; switching; dropcopy;}
}
