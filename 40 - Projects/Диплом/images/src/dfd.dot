digraph dfd {
  graph [rankdir=TB, fontname="Arial", nodesep=0.27, ranksep=0.24, pad=0.2];
  node  [fontname="Arial", fontsize=15, margin="0.08,0.04"];
  edge  [fontname="Arial", fontsize=14, arrowsize=0.6];

  client [label="Клиент S3", shape=box, penwidth=2];
  admin  [label="Администратор", shape=box, penwidth=2];

  node [shape=box, style=rounded];
  p1 [label="1. Сбор\nи дедупликация\nсобытий"];
  p2 [label="2. Агрегирование\nи контроль\nпропусков"];
  p3 [label="3. Построение\nпризнаков"];
  p4 [label="4. Обучение\nи проверка\nмодели"];
  p5 [label="5. Прогноз\nвостребованности"];
  p6 [label="6. Планирование\nи объяснение"];
  p7 [label="7. Исполнение\nпереносов"];

  node [shape=plain, style=solid];
  d1 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D1</TD><TD>Поток событий<BR/>обращений</TD></TR></TABLE>>];
  d2 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D2</TD><TD>События и агрегаты<BR/>активности</TD></TR></TABLE>>];
  d3 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D3</TD><TD>Реестр<BR/>моделей</TD></TR></TABLE>>];
  d4 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D4</TD><TD>Планы, команды,<BR/>настройки и журнал</TD></TR></TABLE>>];
  d5 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D5</TD><TD>Каталог<BR/>и размещение</TD></TR></TABLE>>];
  d6 [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD>D6</TD><TD>Данные<BR/>HOT и COLD</TD></TR></TABLE>>];

  client -> d1 [label="чтения через\nGateway"];
  d1 -> p1 -> d2 [label="события"];
  p1 -> p2 [label="отметки\nпропусков"];
  p2 -> d2 [label="агрегаты"];
  d2 -> p3 [label="окна\n< T"];
  d5 -> p3 [label="размер,\nверсия"];
  d2 -> p4 [label="метки\n[T, T+H)"];
  p3 -> p4 [label="признаки"];
  p4 -> d3 [label="модель"];
  d3 -> p5 [label="модель"];
  p3 -> p5 [label="признаки"];
  p5 -> p6 [label=<<I>N&#770;<SUB>i</SUB></I>, <I>D&#770;<SUB>i</SUB></I>>];
  d5 -> p6 [label="классы,\nзанятость"];
  admin -> d4 [label="ограничения,\nзапреты"];
  d4 -> p6 [label="ограничения"];
  p6 -> d4 [label="план"];
  d4 -> admin [label="рекомендации,\nобоснования"];
  admin -> d4 [label="решение"];
  d4 -> p7 [label="подтверждённые\nдействия"];
  p7 -> d6 [label="копия"];
  p7 -> d5 [label="новое\nрасположение"];
  p7 -> d4 [label="состояние"];
  {rank=same; client; d1; p1;}
  {rank=same; d2; p2;}
  {rank=same; p3; p4; d3;}
  {rank=same; p5; d5;}
  {rank=same; p6;}
  {rank=same; d4; admin;}
  {rank=same; d6; p7;}
}
