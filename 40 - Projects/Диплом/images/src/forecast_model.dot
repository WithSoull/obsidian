digraph forecast_model {
  graph [rankdir=TB, fontname="Arial", nodesep=0.35, ranksep=0.45, pad=0.2];
  node  [shape=box, style="rounded", fontname="Arial", fontsize=16, margin="0.15,0.08"];
  edge  [fontname="Arial", fontsize=15, arrowsize=0.7];

  hist  [label=<История обращений<BR/>и метаданные<BR/>до момента <I>T</I>>];
  feat  [label=<Признаки <I>x<SUB>i</SUB></I>(<I>T</I>)>];
  clf   [label=<Классификатор GBDT<BR/><I>p<SUB>i</SUB></I> = Pr(<I>N<SUB>i</SUB></I> &gt; 0 | <I>x<SUB>i</SUB></I>)>];
  reg   [label=<Регрессор GBDT (Пуассон)<BR/><I>m<SUB>i</SUB></I> = E[<I>N<SUB>i</SUB></I> | <I>N<SUB>i</SUB></I> &gt; 0, <I>x<SUB>i</SUB></I>]>];
  mu    [label=<<I>N&#770;<SUB>i</SUB></I> = <I>p<SUB>i</SUB></I> · <I>m<SUB>i</SUB></I><BR/>прогноз числа чтений>];
  bytes [label=<<I>D&#770;<SUB>i</SUB></I> = <I>N&#770;<SUB>i</SUB></I> · <I>r<SUB>i</SUB></I> · <I>s<SUB>i</SUB></I><BR/>прогноз объёма чтения>];
  plan  [label="Планировщик\nразмещения", style="rounded,bold"];
  base  [label="Базовые оценки\n(EWMA, давность,\nчастота, возраст)", style="rounded,dashed"];

  hist -> feat;
  feat -> clf;
  feat -> reg;
  clf -> mu;
  reg -> mu;
  mu -> bytes;
  mu -> plan;
  bytes -> plan;
  hist -> base [style=dashed];
  base -> plan [style=dashed, label="сравнение политик;\nEWMA – режим F-12"];
  {rank=same; clf; reg; base;}
}
